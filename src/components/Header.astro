---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { mainNav, primaryCta } from '../data/site';
import { serviceCategories } from '../data/services';
---

<header class="site-header" data-header>
  <div class="site-header__bar container">
    <div class="site-header__start">
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-open>
        <Icon name="menu" />
        <span class="visually-hidden">Menu</span>
      </button>
      <nav class="site-nav" aria-label="Main navigation">
        <ul role="list">
          {
            mainNav.map((item) => (
              <li>
                <a href={item.href} data-nav-link>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <a href="#top" class="site-header__logo" aria-label="DD Contracting — back to top">
      <Logo />
    </a>

    <div class="site-header__end">
      <a class="btn btn--gold site-header__cta" href={primaryCta.href}>
        <span class="cta-long">{primaryCta.label}</span>
        <span class="cta-short">Contact</span>
      </a>
    </div>
  </div>
</header>

<div class="menu" id="site-menu" data-menu hidden>
  <div class="menu__backdrop" data-menu-close></div>
  <div class="menu__panel" role="dialog" aria-modal="true" aria-label="Menu" data-menu-panel>
    <div class="menu__top">
      <a href="#top" class="menu__logo" data-menu-link aria-label="DD Contracting — back to top">
        <Logo size="menu" />
      </a>
      <button class="menu__close" type="button" data-menu-close aria-label="Close menu">
        <Icon name="close" />
      </button>
    </div>

    <nav aria-label="Menu">
      <ul class="menu__nav" role="list">
        {
          mainNav.map((item) => (
            <li>
              <a href={item.href} data-menu-link>
                <span>{item.label}</span>
                <Icon name="arrow-up-right" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn btn--gold btn--lg menu__cta" href={primaryCta.href} data-menu-link>
      {primaryCta.label}
      <Icon name="arrow-right" />
    </a>

    <div class="menu__areas">
      <p class="eyebrow eyebrow--on-dark">Service areas</p>
      <ul class="menu__cats" role="list">
        {
          serviceCategories.map((c) => (
            <li>
              <a href={`#vakgebied-${c.slug}`} data-menu-link data-open-services={c.slug}>
                {c.name}
                <span>{c.services.length}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

<style>
  @media (min-width: 64rem) {
    :global(:root) {
      --header-h: 6rem;
    }
  }

  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--text-on-dark);
    transition:
      background-color var(--dur) var(--ease),
      backdrop-filter var(--dur) var(--ease);
    animation: header-in 800ms var(--ease) 250ms backwards;
  }

  @keyframes header-in {
    from {
      opacity: 0;
      transform: translate3d(0, -12px, 0);
    }
  }

  /* Na het scrollen: donkere balk, zodat wit menu en gouden logo leesbaar blijven. */
  .site-header:global(.is-scrolled) {
    background: rgb(11 11 11 / 0.9);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  .site-header__bar {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--header-h);
  }

  .site-header__bar::after {
    content: '';
    position: absolute;
    inset: auto var(--page-pad) 0;
    height: 1px;
    background: var(--border-on-dark);
    transition: opacity var(--dur) var(--ease);
  }

  .site-header:global(.is-scrolled) .site-header__bar::after {
    opacity: 0;
  }

  .site-header__start {
    display: flex;
    align-items: center;
  }

  .site-header__logo {
    display: inline-flex;
    padding: var(--space-8);
    margin: calc(var(--space-8) * -1);
  }

  .site-header__end {
    display: flex;
    justify-content: flex-end;
  }

  .menu-btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--border-on-dark);
    border-radius: var(--radius-pill);
    transition: border-color var(--dur-fast) var(--ease);
  }

  .menu-btn:hover {
    border-color: var(--text-on-dark);
  }

  .menu-btn :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .site-nav {
    display: none;
  }

  .site-nav ul {
    display: flex;
    gap: var(--space-32);
  }

  .site-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--fs-nav);
    font-weight: 500;
    color: var(--text-on-dark);
    transition: color var(--dur-fast) var(--ease);
  }

  .site-nav a::after {
    content: '';
    position: absolute;
    inset: auto 0 0.5rem;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease);
  }

  .site-nav a[aria-current='true']::after {
    transform: scaleX(1);
  }

  @media (hover: hover) and (pointer: fine) {
    .site-nav a:hover::after {
      transform: scaleX(1);
    }
  }

  .cta-long {
    display: none;
  }

  @media (min-width: 64rem) {
    .menu-btn {
      display: none;
    }

    .site-nav {
      display: block;
    }

    .cta-long {
      display: inline;
    }

    .cta-short {
      display: none;
    }
  }

  /* ---------- Uitschuifmenu ---------- */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 100;
  }

  .menu__backdrop {
    position: absolute;
    inset: 0;
    background: rgb(5 5 5 / 0.55);
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .menu__panel {
    position: absolute;
    inset: 0 auto 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
    width: min(26rem, 100%);
    padding: 0 var(--page-pad) var(--space-40);
    overflow-y: auto;
    background: var(--bg-inverse);
    color: var(--text-on-dark);
    --focus: var(--gold);
    transform: translateX(-100%);
    transition: transform var(--dur) var(--ease);
  }

  .menu:global(.is-open) .menu__backdrop {
    opacity: 1;
  }

  .menu:global(.is-open) .menu__panel {
    transform: none;
  }

  /* Minder beweging: menu en balk verschijnen met een fade, zonder te schuiven. */
  @media (prefers-reduced-motion: reduce) {
    .site-header {
      animation-name: header-fade;
    }

    .menu__panel {
      transform: none;
      opacity: 0;
      transition: opacity var(--dur) var(--ease);
    }

    .menu:global(.is-open) .menu__panel {
      opacity: 1;
    }
  }

  @keyframes header-fade {
    from {
      opacity: 0;
    }
  }

  .menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-h);
    border-bottom: 1px solid var(--border-on-dark);
  }

  .menu__close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--border-on-dark);
    border-radius: var(--radius-pill);
  }

  .menu__close :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .menu__nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.5rem;
    border-bottom: 1px solid var(--border-on-dark);
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .menu__nav :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--gold);
  }

  .menu__cta {
    width: 100%;
  }

  .menu__areas {
    display: grid;
    gap: var(--space-16);
  }

  .menu__cats a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.75rem;
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--text-on-dark);
  }

  .menu__cats span {
    color: var(--text-on-dark-muted);
  }
</style>
