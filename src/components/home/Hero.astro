---
import { Picture } from 'astro:assets';
import Icon from '../Icon.astro';
import { hero } from '../../data/home';
import { primaryCta } from '../../data/site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media">
    <Picture
      src={hero.image}
      alt={hero.alt}
      widths={[640, 960, 1280, 1680, 1915]}
      sizes="100vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
      class="hero__img"
    />
    <div class="hero__shade" aria-hidden="true"></div>
  </div>

  <div class="hero__inner container">
    <div class="hero__content">
      <p class="eyebrow eyebrow--on-dark">
        <span class="hero__eyebrow-long">{hero.eyebrow}</span>
        <span class="hero__eyebrow-short">{hero.eyebrowShort}</span>
      </p>
      <h1 id="hero-title" class="hero__title">
        {
          hero.titleLines.map((line, i) => (
            <>
              <span class="hero__line">
                <span class="hero__line-inner" style={`--l:${i}`}>
                  {line}
                </span>
              </span>{' '}
            </>
          ))
        }
      </h1>
      <p class="hero__lead">{hero.lead}</p>
      <div class="hero__actions">
        <a class="btn btn--gold btn--lg" href={primaryCta.href}>
          {primaryCta.label}
          <Icon name="arrow-right" />
        </a>
        <a class="btn btn--outline-dark btn--lg" href="#diensten">Explore our services</a>
      </div>
    </div>

    <ol class="hero__areas" role="list" aria-label="Core service areas">
      {
        hero.areas.map((a, i) => (
          <li style={`--a:${i}`}>
            <a href={`#vakgebied-${a.category}`} data-open-services={a.category}>
              <span class="hero__area-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="hero__area-name">{a.label}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    min-height: auto;
    padding-top: calc(var(--header-h) + var(--space-48));
    padding-bottom: var(--space-40);
    overflow: hidden;
    color: var(--text-on-dark);
    background: var(--bg-inverse);
  }

  @media (min-width: 64rem) {
    .hero {
      min-height: clamp(44rem, 100svh, 56.25rem);
      padding-top: calc(var(--header-h) + var(--space-64));
      padding-bottom: var(--space-64);
    }
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__media :global(picture),
  .hero__media :global(img) {
    width: 100%;
    height: 100%;
  }

  /* De vakman staat rechts in de foto; de tekst valt over de lege hal. */
  .hero__media :global(img) {
    object-fit: cover;
    object-position: 86% 50%;
  }

  @media (min-width: 64rem) {
    .hero__media :global(img) {
      object-position: 90% 50%;
    }
  }

  /* Hele foto verdonkerd (wens klant), extra verloop links achter de tekst en onderaan. */
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(5 5 5 / 0) 40%, rgb(5 5 5 / 0.6) 100%),
      rgb(5 5 5 / 0.55);
  }

  @media (min-width: 64rem) {
    .hero__shade {
      background:
        linear-gradient(90deg, rgb(5 5 5 / 0.6) 0%, rgb(5 5 5 / 0) 62%),
        linear-gradient(180deg, rgb(5 5 5 / 0) 50%, rgb(5 5 5 / 0.6) 100%),
        rgb(5 5 5 / 0.42);
    }
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: var(--space-48);
  }

  .hero__content {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--space-24);
    max-width: 55rem;
  }

  @media (min-width: 64rem) {
    .hero__content {
      gap: var(--space-32);
    }
  }

  .hero__eyebrow-long {
    display: none;
  }

  @media (min-width: 40rem) {
    .hero__eyebrow-long {
      display: inline;
    }

    .hero__eyebrow-short {
      display: none;
    }
  }

  .hero__title {
    font-size: var(--fs-display);
    font-weight: 700;
    line-height: 1.045;
    letter-spacing: -0.04em;
  }

  /* Elke regel is een masker; de tekst schuift er van onderen in. Extra ruimte voor onderstokken. */
  .hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }

  .hero__line-inner {
    display: inline-block;
  }

  .hero__lead {
    max-width: 37.5rem;
    font-size: var(--fs-lead);
    line-height: 1.6;
    color: var(--text-on-dark-muted);
  }

  .hero__actions {
    display: grid;
    gap: var(--space-12);
    width: 100%;
  }

  @media (min-width: 40rem) {
    .hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-16);
      width: auto;
    }
  }

  .hero__areas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--grid-gap);
  }

  @media (min-width: 64rem) {
    .hero__areas {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .hero__areas a {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-8);
    height: 100%;
    padding-top: var(--space-20);
  }

  /* Lijn als pseudo-element, zodat ze kan worden "getekend" (scaleX) zonder layout. */
  .hero__areas a::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--border-on-dark);
    transform-origin: left;
    transition: background-color var(--dur) var(--ease);
  }

  .hero__areas a:hover::before,
  .hero__areas a:focus-visible::before {
    background: var(--gold);
  }

  .hero__area-num {
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--gold-light);
  }

  .hero__area-name {
    font-weight: 500;
    color: var(--text-on-dark);
  }

  /* ---------- Openingssequentie (eenmalig bij het laden) ----------
   * 1. foto zakt rustig in  2. gouden lijn + eyebrow  3. titelregels schuiven uit hun masker
   * 4. inleiding en knoppen  5. lijnen boven de vakgebieden worden van links getekend.
   */
  .hero__media :global(img) {
    animation: hero-settle 2000ms var(--ease) backwards;
  }

  .hero .eyebrow {
    animation: hero-fade 700ms var(--ease) 100ms backwards;
  }

  .hero .eyebrow::before {
    transform-origin: left;
    animation: hero-draw 900ms var(--ease) 150ms backwards;
  }

  .hero__line-inner {
    animation: hero-line var(--dur-hero) var(--ease) backwards;
    animation-delay: calc(200ms + var(--l) * 110ms);
  }

  .hero__lead {
    animation: hero-rise var(--dur-reveal) var(--ease) 480ms backwards;
  }

  .hero__actions {
    animation: hero-rise var(--dur-reveal) var(--ease) 580ms backwards;
  }

  .hero__areas a::before {
    animation: hero-draw 1000ms var(--ease) backwards;
    animation-delay: calc(700ms + var(--a) * 90ms);
  }

  .hero__area-num,
  .hero__area-name {
    animation: hero-rise 700ms var(--ease) backwards;
    animation-delay: calc(780ms + var(--a) * 90ms);
  }

  /* ---------- Parallax bij het scrollen: foto blijft achter, tekst wijkt ---------- */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero__media {
        animation: hero-parallax linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }

      .hero__inner {
        animation: hero-recede linear both;
        animation-timeline: scroll(root);
        animation-range: 0 80vh;
      }
    }
  }

  /* Minder beweging: alleen zachte fades, geen verplaatsing of schaal. */
  @media (prefers-reduced-motion: reduce) {
    .hero__media :global(img),
    .hero .eyebrow::before,
    .hero__areas a::before {
      animation: none;
    }

    .hero__line-inner,
    .hero__lead,
    .hero__actions,
    .hero__area-num,
    .hero__area-name {
      animation-name: hero-fade;
    }
  }

  @keyframes hero-settle {
    from {
      transform: scale(1.08);
    }
  }

  @keyframes hero-line {
    from {
      transform: translate3d(0, 105%, 0);
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translate3d(0, 16px, 0);
    }
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes hero-draw {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes hero-parallax {
    to {
      transform: translate3d(0, 30%, 0);
    }
  }

  @keyframes hero-recede {
    to {
      opacity: 0.25;
      transform: translate3d(0, -6%, 0);
    }
  }
</style>
