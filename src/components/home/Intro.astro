---
import { intro } from '../../data/home';
---

<section class="section intro" aria-labelledby="intro-title">
  <div class="container">
    <div class="intro__statement" data-reveal>
      <p class="eyebrow">{intro.eyebrow}</p>
      <h2 id="intro-title" class="h2">
        {intro.title} <span class="muted">{intro.titleMuted}</span>
      </h2>
    </div>
    <dl class="intro__stats" data-reveal-stagger>
      {
        intro.stats.map((s) => (
          <div class="intro__stat">
            <dt>{s.label}</dt>
            <dd>
              {/^\d+$/.test(s.value) ? (
                <>
                  <span aria-hidden="true" data-count={s.value}>
                    {s.value}
                  </span>
                  <span class="visually-hidden">{s.value}</span>
                </>
              ) : (
                s.value
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .intro__statement {
    display: grid;
    justify-items: start;
    gap: var(--space-16);
  }

  @media (min-width: 64rem) {
    .intro__statement {
      gap: var(--space-24);
    }
  }

  .intro__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--grid-gap);
    margin: 0;
  }

  @media (min-width: 64rem) {
    .intro__stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* Waarde visueel boven het label, in de broncode label eerst (dt/dd). */
  .intro__stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--space-8);
    padding-top: var(--space-24);
    border-top: 1px solid var(--border-strong);
  }

  .intro__stat dd {
    margin: 0;
    font-size: var(--fs-stat);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .intro__stat dt {
    font-size: var(--fs-small);
    line-height: 1.57;
    color: var(--text-muted);
  }
</style>
