---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  title: string;
  eyebrow?: string;
  description?: string;
  href?: string;
  linkLabel?: string;
  /** Label op de foto (variant "feature"). */
  badge?: string;
  /** Kenmerken als chips (variant "feature"). */
  points?: string[];
  /** Later in te vullen bij echte referenties, bv. "Antwerpen · 2026". */
  meta?: string;
  /** Hoogte van de foto: lg / md / tall / feature (zoals Card/Photo en Card/Feature in Figma). */
  size?: 'lg' | 'md' | 'tall' | 'feature';
  sizes?: string;
  position?: string;
  category?: string;
}

const {
  image,
  alt,
  title,
  eyebrow,
  description,
  href,
  linkLabel = 'Learn more',
  badge,
  points,
  meta,
  size = 'md',
  sizes = '(min-width: 64rem) 410px, 100vw',
  position = '50% 50%',
  category,
} = Astro.props;

const widths = size === 'lg' || size === 'feature' ? [480, 720, 960, 1280] : [400, 640, 900, 1200];
---

<article class:list={['card', `card--${size}`]}>
  <div class="card__media">
    <Picture
      src={image}
      alt={alt}
      widths={widths}
      sizes={sizes}
      formats={['avif', 'webp']}
      class="card__img"
      style={`object-position:${position}`}
    />
    {badge && <p class="card__badge">{badge}</p>}
  </div>

  <div class="card__body">
    <div class="card__text">
      {eyebrow && <p class="card__eyebrow">{eyebrow}</p>}
      <h3 class="card__title h3">{title}</h3>
      {meta && <p class="card__meta">{meta}</p>}
      {description && <p class="card__desc">{description}</p>}
      {
        points && points.length > 0 && (
          <ul class="card__points" role="list">
            {points.map((p) => <li>{p}</li>)}
          </ul>
        )
      }
    </div>
    {
      href && (
        <a class="card__link link-arrow" href={href} data-open-services={category}>
          <span class="link-arrow__label">{linkLabel}</span>
          <Icon name="arrow-right" />
          <span class="visually-hidden">: {title}</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--card-bg, var(--surface-card-subtle));
  }

  /* Fotohoogtes: mobiel (375) → desktop (1440), gelijk aan de Figma-varianten. */
  .card__media {
    position: relative;
    height: clamp(12.5rem, 10.739rem + 7.512vw, 17.5rem);
    overflow: hidden;
  }

  .card--lg .card__media {
    height: clamp(13.75rem, 10.669rem + 13.146vw, 22.5rem);
  }

  .card--tall .card__media {
    height: clamp(17.5rem, 13.099rem + 18.779vw, 30rem);
  }

  .card--feature .card__media {
    height: clamp(13.75rem, 9.789rem + 16.901vw, 25rem);
  }

  .card__media :global(picture),
  .card__media :global(img) {
    width: 100%;
    height: 100%;
  }

  .card__media :global(img) {
    object-fit: cover;
    transition: transform 900ms var(--ease);
  }

  .card:hover .card__media :global(img) {
    transform: scale(1.03);
  }

  .card__badge {
    position: absolute;
    top: var(--space-24);
    left: var(--space-24);
    padding: var(--space-8) var(--space-16);
    border-radius: var(--radius-pill);
    background: var(--bg-page);
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    line-height: 1.33;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--card-pad);
  }

  /* Tekst groeit; de link blijft onderaan met minstens 24 px afstand. */
  .card__text {
    display: grid;
    align-content: start;
    gap: var(--space-12);
    flex: 1;
    padding-bottom: var(--space-24);
  }

  .card__eyebrow {
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    line-height: 1.33;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .card__meta {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .card__desc {
    color: var(--text-secondary);
  }

  .card__points {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    padding-top: var(--space-12);
  }

  .card__points li {
    padding: var(--space-8) var(--space-16);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    font-size: var(--fs-small);
    font-weight: 500;
    line-height: 1.57;
    color: var(--text-secondary);
  }

  /* Klikvlak 44 px, visueel dezelfde afstanden als in Figma. */
  .card__link {
    align-self: flex-start;
    margin-block: calc(var(--space-12) * -1);
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover .card__media :global(img) {
      transform: none;
    }
  }
</style>
